# Managed by Ansible. Changes are overwritten.
process.roles=broker,controller
node.id={{ kafka_node_id }}

controller.quorum.voters={% for host in groups['kafka_server'] | sort %}{{ hostvars[host].kafka_node_id }}@{{ hostvars[host].ansible_host }}:{{ kafka_controller_port }}{% if not loop.last %},{% endif %}{% endfor %}{{ '\n' }}
controller.listener.names=CONTROLLER

listeners=SASL_PLAINTEXT://0.0.0.0:{{ kafka_client_port }},PLAINTEXT://0.0.0.0:{{ kafka_inter_broker_port }},CONTROLLER://0.0.0.0:{{ kafka_controller_port }}
advertised.listeners=SASL_PLAINTEXT://{{ ansible_host }}:{{ kafka_client_port }},PLAINTEXT://{{ ansible_host }}:{{ kafka_inter_broker_port }}
inter.broker.listener.name=PLAINTEXT
listener.security.protocol.map=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,SASL_PLAINTEXT:SASL_PLAINTEXT
sasl.enabled.mechanisms={{ kafka_sasl_mechanism }}
listener.name.sasl_plaintext.scram-sha-512.sasl.jaas.config=org.apache.kafka.common.security.scram.ScramLoginModule required;
authorizer.class.name={{ kafka_authorizer_class }}
super.users={{ kafka_super_users | join(';') }}
allow.everyone.if.no.acl.found=false

log.dirs={{ kafka_data_path }}/logs
num.partitions=3
default.replication.factor=3
min.insync.replicas=2
offsets.topic.replication.factor=3
transaction.state.log.replication.factor=3
transaction.state.log.min.isr=2
group.initial.rebalance.delay.ms=0
