apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  # Keep this permission separate from kubeadm's system:coredns ClusterRole.
  name: coredns-endpointslice-get
rules:
  - apiGroups:
      - discovery.k8s.io
    resources:
      - endpointslices
    verbs:
      - get
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: coredns-endpointslice-get
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: coredns-endpointslice-get
subjects:
  - kind: ServiceAccount
    name: coredns
    namespace: {{ coredns_namespace }}